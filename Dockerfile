# Използваме официален Node.js образ като базов
FROM node:18

# Задаваме работна директория в контейнера
WORKDIR /app

# Копираме конфигурационните файлове за зависимостите
COPY package*.json ./

# Инсталираме зависимостите
RUN npm install

# Копираме останалия код
COPY . .

# Декларираме порта, на който работи приложението
EXPOSE 3000

# Команда за стартиране
CMD ["node", "index.js"]